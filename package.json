{
  "name": "gecko",
  "publisher": "tianyy",
  "displayName": "Gecko",
  "description": "Copy selected code with workspace-relative file path and line numbers.",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "icon": "assets/logo/gecko.png",
  "contributes": {
    "commands": [
      {
        "command": "codeRef.copy",
        "title": "Copy Code with File Path and Line Numbers"
      }
    ],
    "keybindings": [
      {
        "command": "codeRef.copy",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codeRef.copy",
          "when": "editorHasSelection",
          "group": "9_cutcopypaste"
        }
      ]
    }
  }
}
